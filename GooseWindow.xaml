<Window x:Class="TakeABreakGoose.GooseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Take a Break Goose"
        Width="360" Height="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Speech bubble -->
        <StackPanel x:Name="Bubble" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Visibility="Collapsed" RenderTransformOrigin="0.5,1">
            <StackPanel.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" />
            </StackPanel.RenderTransform>
            <Border Background="White" BorderBrush="#333333" BorderThickness="2" CornerRadius="14"
                    Padding="14,10" MaxWidth="330">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="16" Foreground="#E07B1A" />
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Foreground="#222222"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12" Foreground="#777777"
                               Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="SnoozeButton" Padding="10,4" Margin="0,0,8,0" Click="Snooze_Click" />
                        <Button x:Name="DismissButton" Padding="10,4" Click="Dismiss_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid HorizontalAlignment="Center" Margin="0,-2,0,0">
                <Polygon Points="0,0 20,0 10,14" Fill="White" />
                <Polyline Points="0,0 10,14 20,0" Stroke="#333333" StrokeThickness="2" />
            </Grid>
        </StackPanel>

        <!-- The goose, drawn facing right. GooseFlip mirrors it to face left. -->
        <Canvas x:Name="Goose" Grid.Row="1" Width="130" Height="120" HorizontalAlignment="Center"
                RenderTransformOrigin="0.5,0.5" Cursor="Hand" Background="Transparent"
                MouseLeftButtonDown="Goose_MouseLeftButtonDown">
            <Canvas.RenderTransform>
                <ScaleTransform x:Name="GooseFlip" ScaleX="1" />
            </Canvas.RenderTransform>

            <Ellipse Canvas.Left="28" Canvas.Top="108" Width="72" Height="9" Fill="#33000000" />

            <!-- Back leg -->
            <Canvas>
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="LegBackRotate" CenterX="56" CenterY="88" />
                </Canvas.RenderTransform>
                <Line X1="56" Y1="86" X2="56" Y2="109" Stroke="#D9711A" StrokeThickness="4"
                      StrokeStartLineCap="Round" />
                <Polygon Points="50,112 68,112 56,105" Fill="#D9711A" />
            </Canvas>

            <!-- Front leg -->
            <Canvas>
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="LegFrontRotate" CenterX="70" CenterY="88" />
                </Canvas.RenderTransform>
                <Line X1="70" Y1="86" X2="70" Y2="109" Stroke="#F28C28" StrokeThickness="4"
                      StrokeStartLineCap="Round" />
                <Polygon Points="64,112 82,112 70,105" Fill="#F28C28" />
            </Canvas>

            <!-- Body, neck and head bob together while walking -->
            <Canvas>
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="BodyBob" />
                </Canvas.RenderTransform>
                <Polygon Points="28,66 6,54 16,78" Fill="White" Stroke="#5A5A5A" StrokeThickness="2"
                         StrokeLineJoin="Round" />
                <Rectangle Canvas.Left="80" Canvas.Top="20" Width="18" Height="48" RadiusX="9" RadiusY="9"
                           Fill="White" Stroke="#5A5A5A" StrokeThickness="2" />
                <Ellipse Canvas.Left="20" Canvas.Top="52" Width="82" Height="44"
                         Fill="White" Stroke="#5A5A5A" StrokeThickness="2" />
                <Path Data="M 40,66 C 55,58 80,62 86,74 C 76,84 52,84 40,66 Z"
                      Fill="#ECECEC" Stroke="#8A8A8A" StrokeThickness="1.5" />
                <Canvas>
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="HeadTilt" CenterX="89" CenterY="30" />
                    </Canvas.RenderTransform>
                    <Ellipse Canvas.Left="76" Canvas.Top="6" Width="32" Height="26"
                             Fill="White" Stroke="#5A5A5A" StrokeThickness="2" />
                    <Polygon Points="104,15 124,21 104,26" Fill="#F28C28" Stroke="#C96A12" StrokeThickness="1"
                             StrokeLineJoin="Round" />
                    <Ellipse Canvas.Left="94" Canvas.Top="12" Width="5" Height="6" Fill="Black" />
                </Canvas>
            </Canvas>
        </Canvas>
    </Grid>
</Window>
