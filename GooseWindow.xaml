<Window x:Class="TakeABreakGoose.GooseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TakeABreakGoose"
        Title="Take a Break Goose"
        Width="440" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="BubbleFill" Color="#FFFDF8" />
        <SolidColorBrush x:Key="BubbleEdge" Color="#E4D9C4" />
        <SolidColorBrush x:Key="Accent" Color="#F28C28" />
        <SolidColorBrush x:Key="AccentDark" Color="#D9711A" />
        <SolidColorBrush x:Key="Slate" Color="#5E7773" />

        <Style x:Key="BubbleButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#3A3A3A" />
            <Setter Property="BorderBrush" Value="#D9CFBD" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F5EFE3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EDE4D3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBubbleButton" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentDark}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E57E1E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkBubbleButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Slate}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2,6">
                            <TextBlock x:Name="Label"
                                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                                <Setter Property="Foreground" Value="#3F5552" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Speech bubble -->
        <StackPanel x:Name="Bubble" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Visibility="Collapsed" RenderTransformOrigin="0.5,1" Margin="0,0,0,2">
            <StackPanel.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" />
            </StackPanel.RenderTransform>
            <StackPanel.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.28" Color="#4A3B22" />
            </StackPanel.Effect>

            <Border Background="{StaticResource BubbleFill}" BorderBrush="{StaticResource BubbleEdge}"
                    BorderThickness="1.5" CornerRadius="16" Padding="18,14,18,14" MinWidth="280" MaxWidth="430">
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentDark}" />
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Foreground="#2B2B2B"
                               LineHeight="20" Margin="0,4,0,0" />
                    <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12" Foreground="#8A8172"
                               Margin="0,6,0,0" />
                    <DockPanel Margin="0,14,0,0" LastChildFill="False">
                        <Button x:Name="FinishUpButton" DockPanel.Dock="Left" Content="Let me finish up"
                                Style="{StaticResource LinkBubbleButton}" Margin="0,0,16,0" Click="FinishUp_Click" />
                        <Button x:Name="DismissButton" DockPanel.Dock="Right"
                                Style="{StaticResource PrimaryBubbleButton}" Click="Dismiss_Click" />
                        <Button x:Name="SnoozeButton" DockPanel.Dock="Right" Margin="0,0,8,0"
                                Style="{StaticResource BubbleButton}" Click="Snooze_Click" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Tail, drawn over the border so the bubble edge flows into it -->
            <Grid HorizontalAlignment="Center" Margin="0,-1.5,0,0">
                <Polygon Points="0,0 22,0 11,12" Fill="{StaticResource BubbleFill}" />
                <Polyline Points="0,0 11,12 22,0" Stroke="{StaticResource BubbleEdge}" StrokeThickness="1.5"
                          StrokeLineJoin="Round" />
            </Grid>
        </StackPanel>

        <!-- Break progress, shown while the goose naps -->
        <Border x:Name="BreakCard" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Visibility="Collapsed" Margin="0,0,0,-6" Background="{StaticResource BubbleFill}"
                BorderBrush="{StaticResource BubbleEdge}" BorderThickness="1.5" CornerRadius="14"
                Padding="10,8,16,8" RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BreakCardScale" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.22" Color="#4A3B22" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Grid Width="36" Height="36" VerticalAlignment="Center">
                    <Ellipse Stroke="#EDE4D3" StrokeThickness="4" Margin="2" />
                    <Path x:Name="BreakRing" Stroke="{StaticResource Accent}" StrokeThickness="4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BreakTitle" Text="Napping during your break" FontSize="13" FontWeight="SemiBold"
                               Foreground="#2B2B2B" />
                    <TextBlock x:Name="BreakTimeText" FontSize="12" Foreground="#8A8172" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <local:GooseFigure x:Name="Figure" Grid.Row="1" HorizontalAlignment="Center" Cursor="Hand"
                           MouseLeftButtonDown="Figure_MouseLeftButtonDown" />
    </Grid>
</Window>
