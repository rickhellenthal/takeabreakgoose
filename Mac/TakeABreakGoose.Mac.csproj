<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The macOS app, built with Avalonia on the shared core. Avalonia brings its own macOS backend, so
    this is plain net8.0 and builds on Windows too (where it runs as well, which helps check the
    windows and pages; the macOS-only parts in Platform/ do nothing there).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>TakeABreakGoose</RootNamespace>
    <AssemblyName>TakeABreakGoose</AssemblyName>
    <Product>Take a Break Goose</Product>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\TakeABreakGoose.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same icon as the Windows app. -->
    <AvaloniaResource Include="..\Assets\goose.ico" Link="Assets\goose.ico" />
  </ItemGroup>

</Project>
