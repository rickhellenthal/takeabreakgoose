<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:TakeABreakGoose"
        xmlns:local="clr-namespace:TakeABreakGoose"
        x:Class="TakeABreakGoose.GooseWindow"
        Title="Take a Break Goose"
        Width="440" Height="360"
        SystemDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" CanResize="False">
    <Window.Resources>
        <SolidColorBrush x:Key="BubbleFill" Color="#FFFDF8" />
        <SolidColorBrush x:Key="BubbleEdge" Color="#E4D9C4" />
        <SolidColorBrush x:Key="Accent" Color="#F28C28" />
        <SolidColorBrush x:Key="AccentDark" Color="#D9711A" />
        <SolidColorBrush x:Key="Slate" Color="#5E7773" />

        <!-- Own themes rather than styles on the Fluent button, so none of its hover colours or press effect show. -->
        <ControlTheme x:Key="BubbleButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#3A3A3A" />
            <Setter Property="BorderBrush" Value="#D9CFBD" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Chrome">
                <Setter Property="Background" Value="#F5EFE3" />
            </Style>
            <Style Selector="^:pressed /template/ Border#Chrome">
                <Setter Property="Background" Value="#EDE4D3" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="PrimaryBubbleButton" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentDark}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style Selector="^:pointerover /template/ Border#Chrome">
                <Setter Property="Background" Value="#E57E1E" />
            </Style>
            <Style Selector="^:pressed /template/ Border#Chrome">
                <Setter Property="Background" Value="{StaticResource AccentDark}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="LinkBubbleButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Slate}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" Padding="2,6">
                        <TextBlock Name="Label" Text="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="#3F5552" />
            </Style>
            <Style Selector="^:pointerover /template/ TextBlock#Label">
                <Setter Property="TextDecorations" Value="Underline" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Grid RowDefinitions="*,Auto">
        <!-- Speech bubble -->
        <StackPanel x:Name="Bubble" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    IsVisible="False" RenderTransformOrigin="50%,100%" Margin="0,0,0,2">
            <StackPanel.RenderTransform>
                <ScaleTransform />
            </StackPanel.RenderTransform>
            <StackPanel.Effect>
                <DropShadowEffect BlurRadius="18" OffsetX="0" OffsetY="3" Opacity="0.28" Color="#4A3B22" />
            </StackPanel.Effect>

            <Border Background="{StaticResource BubbleFill}" BorderBrush="{StaticResource BubbleEdge}"
                    BorderThickness="1.5" CornerRadius="16" Padding="18,14,18,14" MinWidth="280" MaxWidth="430">
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentDark}" />
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Foreground="#2B2B2B"
                               LineHeight="20" Margin="0,4,0,0" />
                    <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12" Foreground="#8A8172"
                               Margin="0,6,0,0" />
                    <DockPanel Margin="0,14,0,0" LastChildFill="False">
                        <!-- When it's break time: Snooze is the quiet link, "Let me finish up" the outlined button. -->
                        <Button x:Name="LinkButton" DockPanel.Dock="Left"
                                Theme="{StaticResource LinkBubbleButton}" Margin="0,0,16,0" Click="Link_Click" />
                        <Button x:Name="DismissButton" DockPanel.Dock="Right"
                                Theme="{StaticResource PrimaryBubbleButton}" Click="Dismiss_Click" />
                        <Button x:Name="SecondaryButton" DockPanel.Dock="Right" Margin="0,0,8,0"
                                Theme="{StaticResource BubbleButton}" Click="Secondary_Click" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Tail, drawn over the border so the bubble edge flows into it -->
            <Grid HorizontalAlignment="Center" Margin="0,-1.5,0,0">
                <Polygon Points="0,0 22,0 11,12" Fill="{StaticResource BubbleFill}" />
                <Polyline Points="0,0 11,12 22,0" Stroke="{StaticResource BubbleEdge}" StrokeThickness="1.5"
                          StrokeJoin="Round" />
            </Grid>
        </StackPanel>

        <!-- Break progress, shown while the goose naps -->
        <Border x:Name="BreakCard" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                IsVisible="False" Margin="0,0,0,-6" Background="{StaticResource BubbleFill}"
                BorderBrush="{StaticResource BubbleEdge}" BorderThickness="1.5" CornerRadius="14"
                Padding="10,8,16,8" RenderTransformOrigin="50%,100%">
            <Border.RenderTransform>
                <ScaleTransform />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" OffsetX="0" OffsetY="2" Opacity="0.22" Color="#4A3B22" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Grid Width="36" Height="36" VerticalAlignment="Center">
                    <Ellipse Stroke="#EDE4D3" StrokeThickness="4" Margin="2" />
                    <Path x:Name="BreakRing" Stroke="{StaticResource Accent}" StrokeThickness="4"
                          StrokeLineCap="Round" />
                </Grid>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BreakTitle" Text="{x:Static s:Strings.GooseNappingDuringBreak}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#2B2B2B" />
                    <TextBlock x:Name="BreakTimeText" FontSize="12" Foreground="#8A8172" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <local:GooseFigure x:Name="Figure" Grid.Row="1" HorizontalAlignment="Center" Cursor="Hand"
                           PointerPressed="Figure_PointerPressed" />
    </Grid>
</Window>
