<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TakeABreakGoose</RootNamespace>
    <AssemblyName>TakeABreakGoose</AssemblyName>
    <Product>Take a Break Goose</Product>
    <Version>1.3.0</Version>
    <ApplicationIcon>Assets\goose.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\goose.ico" />
  </ItemGroup>

  <!-- The tests are a project of their own; keep their files out of the app. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
    <InternalsVisibleTo Include="TakeABreakGoose.Tests" />
  </ItemGroup>

</Project>
