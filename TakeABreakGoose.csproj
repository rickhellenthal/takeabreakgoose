<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TakeABreakGoose</RootNamespace>
    <AssemblyName>TakeABreakGoose</AssemblyName>
    <Product>Take a Break Goose</Product>
    <ApplicationIcon>Assets\goose.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\goose.ico" />
  </ItemGroup>

  <!-- The shared core, the macOS app and the tests are projects of their own; keep their files out of the app. -->
  <ItemGroup>
    <Compile Remove="Core\**;Mac\**;tests\**" />
    <None Remove="Core\**;Mac\**;tests\**" />
    <Page Remove="Core\**;Mac\**;tests\**" />
    <EmbeddedResource Remove="Core\**;Mac\**;tests\**" />
    <InternalsVisibleTo Include="TakeABreakGoose.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\TakeABreakGoose.Core.csproj" />
  </ItemGroup>

</Project>
