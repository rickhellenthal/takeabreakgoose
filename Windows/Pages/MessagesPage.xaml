<UserControl x:Class="TakeABreakGoose.MessagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:TakeABreakGoose;assembly=TakeABreakGoose.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static s:Strings.MessagesResetToDefaults}" Style="{StaticResource ChipButton}"
                            Margin="12,0,0,0" VerticalAlignment="Top" Click="ResetMessages_Click" />
                    <StackPanel>
                        <TextBlock Text="{x:Static s:Strings.SettingsMessages}" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                   Text="{x:Static s:Strings.MessagesHint}" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                              Focusable="False">
                    <ItemsControl x:Name="MessageList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="6,3,3,3" Margin="0,0,0,6" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FAF7F2" />
                                            <Setter Property="BorderBrush" Value="#EFE8DC" />
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}"
                                                ToolTip="{x:Static s:Strings.MessagesRemove}" Click="RemoveMessage_Click" />
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                                 Padding="2,4" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <DockPanel Grid.Row="2" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="{x:Static s:Strings.MessagesAdd}" Style="{StaticResource BaseButton}"
                            Padding="16,5" Margin="8,0,0,0" Click="AddMessage_Click" />
                    <Grid>
                        <TextBox x:Name="NewMessageBox" Padding="6,5" KeyDown="NewMessageBox_KeyDown"
                                 TextChanged="NewMessageBox_TextChanged" />
                        <TextBlock x:Name="NewMessageHint" Text="{x:Static s:Strings.MessagesAddPlaceholder}" Style="{StaticResource Hint}"
                                   FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="{x:Static s:Strings.Save}" Style="{StaticResource PrimaryButton}" Padding="24,7"
                    Click="Save_Click" />
            <TextBlock x:Name="Status" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                       TextWrapping="Wrap" MaxWidth="260" />
        </DockPanel>
    </Grid>
</UserControl>
