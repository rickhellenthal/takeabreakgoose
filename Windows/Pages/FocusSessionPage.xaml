<UserControl x:Class="TakeABreakGoose.FocusSessionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:TakeABreakGoose;assembly=TakeABreakGoose.Core">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>
            <!-- No padding of its own: the session fills the top, the breaks a tinted footer at the bottom. -->
            <Border x:Name="ActiveCard" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Margin="18,16">
                        <TextBlock Text="{x:Static s:Strings.SessionRunning}" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="CountdownText" FontSize="40" FontWeight="Light" Margin="0,6,0,0" />
                        <TextBlock x:Name="CountdownCaption" Style="{StaticResource Hint}" FontSize="13" />
                        <TextBlock x:Name="SessionEndText" Style="{StaticResource Hint}" Margin="0,10,0,0" />

                        <Border Background="#FAF7F2" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
                            <DockPanel>
                                <ToggleButton x:Name="DoNotDisturbSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                              Margin="12,0,0,0" Style="{StaticResource Switch}"
                                              Checked="DoNotDisturbSwitch_Changed" Unchecked="DoNotDisturbSwitch_Changed" />
                                <StackPanel>
                                    <TextBlock Text="{x:Static s:Strings.SessionDoNotDisturb}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DoNotDisturbHint" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="{x:Static s:Strings.SessionStop}" Style="{StaticResource PrimaryButton}"
                                    Click="StopSession_Click" />
                            <Button Content="{x:Static s:Strings.TakeABreakNow}" Style="{StaticResource BaseButton}"
                                    Margin="8,0,0,0" Click="BreakNow_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- The breaks taken so far in this session, newest first (filled in from code).
                         Only there once there's been a break. -->
                    <Border x:Name="BreaksFooter" Visibility="Collapsed" Background="#F7F2EA"
                            BorderBrush="#E8E1D6" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,9,9" Padding="18,12,18,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="BreaksSummary" DockPanel.Dock="Right" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                <TextBlock Text="{x:Static s:Strings.SessionBreaksThisSession}" FontWeight="SemiBold" />
                            </DockPanel>
                            <StackPanel x:Name="BreakList" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- The session ended during Do not disturb: the goose's goodbye is waiting. -->
            <Border x:Name="SignOffBanner" Style="{StaticResource Card}" Background="#FAF7F2" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static s:Strings.SessionTurnOffDoNotDisturb}" Style="{StaticResource BaseButton}"
                            VerticalAlignment="Center" Margin="12,0,0,0" Click="EndDoNotDisturb_Click" />
                    <StackPanel>
                        <TextBlock Text="{x:Static s:Strings.SessionDoneTitle}" FontWeight="SemiBold" />
                        <TextBlock x:Name="SignOffHint" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border x:Name="StartCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{x:Static s:Strings.SessionStartTitle}" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                               Text="{x:Static s:Strings.SessionStartHint}" />

                    <TextBlock Text="{x:Static s:Strings.SessionRemindEvery}" Margin="0,16,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Interval15" Tag="15" GroupName="Interval"
                                     Style="{StaticResource ChoiceChip}" Checked="Interval_Checked" />
                        <RadioButton x:Name="Interval30" Tag="30" GroupName="Interval"
                                     Style="{StaticResource ChoiceChip}" Checked="Interval_Checked" />
                        <RadioButton x:Name="Interval45" Tag="45" GroupName="Interval"
                                     Style="{StaticResource ChoiceChip}" Checked="Interval_Checked" />
                        <RadioButton x:Name="Interval60" Tag="60" GroupName="Interval"
                                     Style="{StaticResource ChoiceChip}" Checked="Interval_Checked" />
                        <RadioButton x:Name="IntervalCustom" Content="{x:Static s:Strings.Other}" GroupName="Interval"
                                     Style="{StaticResource OtherChoiceChip}" Checked="Interval_Checked" />
                    </StackPanel>
                    <StackPanel x:Name="CustomIntervalPanel" Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="Collapsed">
                        <TextBlock Text="{x:Static s:Strings.SessionEvery}" Style="{StaticResource Label}" Margin="0,0,8,0" />
                        <TextBox x:Name="SessionIntervalBox" Width="56" GotKeyboardFocus="NumberBox_GotKeyboardFocus" />
                        <TextBlock Text="{x:Static s:Strings.SessionMinutes}" Style="{StaticResource Label}" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{x:Static s:Strings.SessionEachBreakLasts}" Margin="0,16,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Break5" Tag="5" GroupName="BreakLength"
                                     Style="{StaticResource ChoiceChip}" Checked="BreakLength_Checked" />
                        <RadioButton x:Name="Break10" Tag="10" GroupName="BreakLength"
                                     Style="{StaticResource ChoiceChip}" Checked="BreakLength_Checked" />
                        <RadioButton x:Name="Break15" Tag="15" GroupName="BreakLength"
                                     Style="{StaticResource ChoiceChip}" Checked="BreakLength_Checked" />
                        <RadioButton x:Name="BreakCustom" Content="{x:Static s:Strings.Other}" GroupName="BreakLength"
                                     Style="{StaticResource OtherChoiceChip}" Checked="BreakLength_Checked" />
                    </StackPanel>
                    <StackPanel x:Name="CustomBreakPanel" Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="Collapsed">
                        <TextBox x:Name="SessionBreakBox" Width="56" GotKeyboardFocus="NumberBox_GotKeyboardFocus" />
                        <TextBlock Text="{x:Static s:Strings.TimeMinutesLabel}" Style="{StaticResource Label}" Margin="8,0,12,0" />
                        <TextBox x:Name="SessionBreakSecondsBox" Width="56" GotKeyboardFocus="NumberBox_GotKeyboardFocus" />
                        <TextBlock Text="{x:Static s:Strings.TimeSecondsLabel}" Style="{StaticResource Label}" Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- Optional: when the session ends. Tucked away so a quick start stays quick. -->
                    <ToggleButton x:Name="EndOptionsToggle" Style="{StaticResource LinkToggle}"
                                  HorizontalAlignment="Left" Margin="-4,10,0,0"
                                  Checked="EndOptionsToggle_Changed" Unchecked="EndOptionsToggle_Changed" />
                    <Border x:Name="EndOptionsPanel" Background="#FAF7F2" CornerRadius="8" Padding="14,12"
                            Margin="0,4,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- The option that isn't picked is greyed out (UpdateEndModeLook), but still works:
                                 clicking or typing in it picks it. -->
                            <RadioButton x:Name="EndAfterRadio" Grid.Row="0" Content="{x:Static s:Strings.SessionEndAfter}" GroupName="EndMode"
                                         VerticalAlignment="Top" VerticalContentAlignment="Center" Margin="0,4,14,10"
                                         Checked="EndOption_Changed" />
                            <StackPanel x:Name="EndAfterInputs" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Length60" Tag="60" GroupName="Length"
                                                 Style="{StaticResource SmallChoiceChip}" Checked="Length_Checked" Click="EndAfterInput_Picked" />
                                    <RadioButton x:Name="Length120" Tag="120" GroupName="Length"
                                                 Style="{StaticResource SmallChoiceChip}" Checked="Length_Checked" Click="EndAfterInput_Picked" />
                                    <RadioButton x:Name="Length180" Tag="180" GroupName="Length"
                                                 Style="{StaticResource SmallChoiceChip}" Checked="Length_Checked" Click="EndAfterInput_Picked" />
                                    <RadioButton x:Name="Length240" Tag="240" GroupName="Length"
                                                 Style="{StaticResource SmallChoiceChip}" Checked="Length_Checked" Click="EndAfterInput_Picked" />
                                    <RadioButton x:Name="LengthCustom" Content="{x:Static s:Strings.Other}" GroupName="Length"
                                                 Style="{StaticResource SmallOtherChoiceChip}" Checked="Length_Checked" Click="EndAfterInput_Picked" />
                                </StackPanel>
                                <StackPanel x:Name="CustomLengthPanel" Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="Collapsed">
                                    <TextBox x:Name="SessionHoursBox" Width="40" GotFocus="EndAfterInput_Picked"
                                             TextChanged="EndOption_Changed" />
                                    <TextBlock Text="{x:Static s:Strings.TimeHoursLabel}" Style="{StaticResource Label}" Margin="6,0,8,0" />
                                    <TextBox x:Name="SessionMinutesBox" Width="40" GotFocus="EndAfterInput_Picked"
                                             TextChanged="EndOption_Changed" />
                                    <TextBlock Text="{x:Static s:Strings.TimeMinutesLabel}" Style="{StaticResource Label}" Margin="6,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <RadioButton x:Name="EndAtRadio" Grid.Row="1" Content="{x:Static s:Strings.SessionEndAt}" GroupName="EndMode"
                                         VerticalContentAlignment="Center" Margin="0,0,14,0"
                                         Checked="EndOption_Changed" />
                            <StackPanel x:Name="EndAtInputs" Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="SessionEndTimeBox" Width="56" GotFocus="EndAtInput_Picked"
                                         TextChanged="EndOption_Changed" PreviewKeyDown="SessionEndTimeBox_PreviewKeyDown"                                         ToolTip="{x:Static s:Strings.SessionEndTimeToolTip}" />
                                <Button Content="{x:Static s:Strings.SessionEarlier15}" Tag="-15" Style="{StaticResource ChipButton}" Margin="8,0,6,0"
                                        Click="EndTimeStep_Click" />
                                <Button Content="{x:Static s:Strings.SessionLater15}" Tag="15" Style="{StaticResource ChipButton}"
                                        Click="EndTimeStep_Click" />
                            </StackPanel>

                            <TextBlock x:Name="EndPreview" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                       FontSize="12" Foreground="#5E7773" TextWrapping="Wrap" />                        </Grid>
                    </Border>

                    <TextBlock x:Name="SessionError" Foreground="#C62828" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed" />

                    <!-- Always the last thing in the card, whether or not an end time is set. -->
                    <Button Content="{x:Static s:Strings.SessionStart}" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Padding="22,8" Margin="0,16,0,0"
                            Click="StartSession_Click" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="AutoStartNote" Style="{StaticResource Hint}" Margin="4,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
