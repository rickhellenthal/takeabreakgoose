<UserControl x:Class="TakeABreakGoose.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <CheckBox x:Name="StartWithWindowsCheck" Content="Start Take a Break Goose when my computer starts" />
                        <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0"
                                   Text="It starts as soon as you sign in to Windows. It's also listed under Startup apps in Task Manager." />

                        <CheckBox x:Name="AutoStartCheck" Content="Start a focus session when the app starts"
                                  Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="22,8,0,0"
                                    IsEnabled="{Binding IsChecked, ElementName=AutoStartCheck}">
                            <TextBlock Text="with a break every" Style="{StaticResource Label}" Margin="0,0,8,0" />
                            <TextBox x:Name="AutoStartIntervalBox" Width="56" />
                            <TextBlock Text="minutes, until you stop it" Style="{StaticResource Label}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="22,6,0,0"
                                   Text="Together with the option above, the goose keeps an eye on you from the moment you sign in, without you having to start a session." />

                        <CheckBox x:Name="CallDoNotDisturbCheck" Content="Turn on Do not disturb during calls"
                                  Margin="0,14,0,0" />
                        <TextBlock Style="{StaticResource Hint}" Margin="22,6,0,0"
                                   Text="The goose notices a call when your camera is in use, or when a meeting app like Teams, Zoom or Google Meet uses your microphone. Voice chat in games and Discord doesn't count. Do not disturb turns off again when the call is over." />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="Shortcut to open this window" Style="{StaticResource Label}" />
                            <TextBox x:Name="HotkeyBox" Width="150" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     Cursor="Arrow" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     ToolTip="Click here and press the key combination you want, e.g. Ctrl+Alt+G" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Breaks" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="AllowSnoozeCheck" Content="Let me snooze for"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Column="1" x:Name="SnoozeBox" Width="56"
                                     IsEnabled="{Binding IsChecked, ElementName=AllowSnoozeCheck}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="min · turn off to hide the Snooze button when it's time for a break" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                   Text="Away from your computer for at least as long as your break? That counts as your break, and the countdown to the next one starts fresh when you're back." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Edit messages" Style="{StaticResource BaseButton}"
                                VerticalAlignment="Center" Margin="12,0,0,0" Click="EditMessages_Click" />
                        <StackPanel>
                            <TextBlock Text="Messages" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="The goose picks one of these at random when it's time for a break." />
                            <TextBlock x:Name="MessageCountText" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Version, and a quiet note when a newer one is out -->
                <StackPanel HorizontalAlignment="Center" Margin="0,2,0,6">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Run Text="Enjoying the goose?" />
                        <Hyperlink Foreground="#5E7773" Click="KoFi_Click">Buy me a coffee</Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="UpdateText" Visibility="Collapsed" HorizontalAlignment="Center"
                               FontSize="12" Foreground="#B85F12" Margin="0,4,0,0">
                        <Run x:Name="UpdateRun" />
                        <Hyperlink Foreground="#B85F12" Click="DownloadUpdate_Click">Download</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}" Padding="24,7"
                    Click="SaveSettings_Click" />
            <TextBlock x:Name="SettingsStatus" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                       TextWrapping="Wrap" MaxWidth="260" />
        </DockPanel>
    </Grid>
</UserControl>
