<UserControl x:Class="TakeABreakGoose.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <CheckBox x:Name="StartWithWindowsCheck" Content="Start Take a Break Goose when I sign in to Windows" />

                        <CheckBox x:Name="AutoStartCheck" Content="Start a focus session when the app starts"
                                  Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="22,8,0,0"
                                    IsEnabled="{Binding IsChecked, ElementName=AutoStartCheck}">
                            <TextBlock Text="with a break every" Style="{StaticResource Label}" Margin="0,0,8,0" />
                            <TextBox x:Name="AutoStartIntervalBox" Width="56" />
                            <TextBlock Text="minutes, until you stop it" Style="{StaticResource Label}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="22,6,0,0"
                                   Text="Together with the option above, the goose keeps an eye on you from the moment you sign in, without you having to start a session." />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="Shortcut to open this window" Style="{StaticResource Label}" />
                            <TextBox x:Name="HotkeyBox" Width="150" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     Cursor="Arrow" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     ToolTip="Click here and press the key combination you want, e.g. Ctrl+Alt+G" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Breaks" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Default break length" Style="{StaticResource Label}" Margin="0,0,12,8" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="BreakBox" Width="56" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,8"
                                       VerticalAlignment="Center"
                                       Text="min · you can pick another length when you start a session" />

                            <TextBlock Grid.Row="1" Text="Snooze length" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="SnoozeBox" Width="56" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Text="min" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                   Text="Away from your computer for at least a break's length? That counts as your break, and the countdown to the next one starts fresh when you're back." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Reset to defaults" Style="{StaticResource ChipButton}"
                                    Margin="0" Click="ResetMessages_Click" />
                            <TextBlock Text="Messages" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,10"
                                   Text="The goose picks one of these at random when it's time for a break. Click a message to edit it." />

                        <ItemsControl x:Name="MessageList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="6,3,3,3" Margin="0,0,0,6" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FAF7F2" />
                                                <Setter Property="BorderBrush" Value="#EFE8DC" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="Background" Value="White" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}"
                                                    ToolTip="Remove this message" Click="RemoveMessage_Click" />
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                                     Padding="2,4" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource BaseButton}"
                                    Padding="16,5" Margin="8,0,0,0" Click="AddMessage_Click" />
                            <Grid>
                                <TextBox x:Name="NewMessageBox" Padding="6,5" KeyDown="NewMessageBox_KeyDown"
                                         TextChanged="NewMessageBox_TextChanged" />
                                <TextBlock x:Name="NewMessageHint" Text="Add a message…" Style="{StaticResource Hint}"
                                           FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Version, and a quiet note when a newer one is out -->
                <StackPanel HorizontalAlignment="Center" Margin="0,2,0,6">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Run Text="Enjoying the goose?" />
                        <Hyperlink Foreground="#5E7773" Click="KoFi_Click">Buy me a coffee</Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="UpdateText" Visibility="Collapsed" HorizontalAlignment="Center"
                               FontSize="12" Foreground="#B85F12" Margin="0,4,0,0">
                        <Run x:Name="UpdateRun" />
                        <Hyperlink Foreground="#B85F12" Click="DownloadUpdate_Click">Download</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}" Padding="24,7"
                    Click="SaveSettings_Click" />
            <TextBlock x:Name="SettingsStatus" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                       TextWrapping="Wrap" MaxWidth="260" />
        </DockPanel>
    </Grid>
</UserControl>
