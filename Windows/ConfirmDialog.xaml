<Window x:Class="TakeABreakGoose.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/goose.ico"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" Background="#FAF7F2"
        FontFamily="Segoe UI" FontSize="13" Foreground="#222222">
    <!-- A fixed width, pixel snapping and a redraw once shown (code-behind): without them, sizing to the
         content can leave black strips at the edges on some display scales. -->
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#7A7A7A" Margin="0,4,0,18" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource BaseButton}" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="22,7"
                    IsDefault="True" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
