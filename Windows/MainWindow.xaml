<Window x:Class="TakeABreakGoose.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TakeABreakGoose"
        Title="Take a Break Goose"
        Width="540" Height="640" MinHeight="420" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Icon="/Assets/goose.ico"
        FontFamily="Segoe UI" FontSize="13" Background="#FAF7F2" Foreground="#222222">
    <!-- The styles live in Styles.xaml; each tab is its own page in Pages/. -->
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Image x:Name="HeaderIcon" Width="42" Height="42" DockPanel.Dock="Left" />
            <StackPanel Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="Take a Break Goose" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="HeaderStatus" Style="{StaticResource Hint}" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="SessionTab" Content="Focus session" GroupName="Tabs"
                         Style="{StaticResource TabPill}" IsChecked="True" Checked="Tab_Checked" />
            <RadioButton x:Name="WardrobeTab" Content="Wardrobe" GroupName="Tabs"
                         Style="{StaticResource TabPill}" Checked="Tab_Checked" />
            <RadioButton x:Name="SettingsTab" Content="Settings" GroupName="Tabs"
                         Style="{StaticResource TabPill}" Checked="Tab_Checked" />
        </StackPanel>

        <Grid Grid.Row="2">
            <local:FocusSessionPage x:Name="SessionView" />
            <local:WardrobePage x:Name="WardrobeView" Visibility="Collapsed" />
            <local:SettingsPage x:Name="SettingsView" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
