<Window x:Class="TakeABreakGoose.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved changes" Icon="/Assets/goose.ico"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" Background="#FAF7F2"
        FontFamily="Segoe UI" FontSize="13" Foreground="#222222">
    <!-- A fixed width, pixel snapping and a redraw once shown (code-behind): without them, sizing to the
         content can leave black strips at the edges on some display scales. -->
    <StackPanel Margin="22,18,22,18">
        <TextBlock Text="Save your changes?" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="You changed some settings but didn't save them yet." TextWrapping="Wrap"
                   Foreground="#7A7A7A" Margin="0,4,0,18" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Keep editing" Style="{StaticResource BaseButton}" IsCancel="True" Click="KeepEditing_Click" />
            <Button Content="Discard" Style="{StaticResource BaseButton}" Margin="8,0,0,0" Click="Discard_Click" />
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="22,7"
                    IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
