<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:TakeABreakGoose"
        x:Class="TakeABreakGoose.UnsavedChangesDialog"
        Title="{x:Static s:Strings.UnsavedTitle}" Icon="/Assets/goose.ico"
        Width="440" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#FAF7F2"
        FontSize="13" Foreground="#222222">
    <StackPanel Margin="22,18,22,18">
        <TextBlock Text="{x:Static s:Strings.UnsavedHeading}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                   Foreground="#7A7A7A" Margin="0,4,0,18" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static s:Strings.UnsavedKeepEditing}" Classes="BaseButton" IsCancel="True" Click="KeepEditing_Click" />
            <Button Content="{x:Static s:Strings.UnsavedDiscard}" Classes="BaseButton" Margin="8,0,0,0" Click="Discard_Click" />
            <Button Content="{x:Static s:Strings.Save}" Classes="PrimaryButton" Margin="8,0,0,0" Padding="22,7"
                    IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
