<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:TakeABreakGoose"
             x:Class="TakeABreakGoose.WardrobePage">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <!-- The cards are filled in from code, one per outfit. -->
        <StackPanel>
            <TextBlock Classes="Hint" FontSize="13" Margin="2,0,2,12"
                       Text="{x:Static s:Strings.WardrobeHint}" />
            <Border x:Name="WardrobeBusyText" IsVisible="False" Background="#FDEBD8" CornerRadius="8"
                    Padding="12,8" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap" Foreground="#8A4A10" FontSize="12"
                           Text="{x:Static s:Strings.WardrobeBusy}" />
            </Border>
            <UniformGrid x:Name="WardrobeGrid" Columns="2" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
