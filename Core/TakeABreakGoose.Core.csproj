<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What the goose does, without any windows: focus sessions and breaks, settings, and the texts
    the goose says. Plain .NET with no user interface, so its tests run anywhere.
    What it needs from the computer (the clock, the mouse and keyboard) comes in through Platform/.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>TakeABreakGoose</RootNamespace>
    <AssemblyName>TakeABreakGoose.Core</AssemblyName>
    <Product>Take a Break Goose</Product>
  </PropertyGroup>

  <!--
    The texts, in English (Strings.resx) and Dutch (Strings.nl.resx). The build turns Strings.resx into
    the Strings class, with a property per text, which both apps use as well (see docs/architecture.md).
  -->
  <ItemGroup>
    <EmbeddedResource Update="Text\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>TakeABreakGoose</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedManifestPrefix>TakeABreakGoose.Text</StronglyTypedManifestPrefix>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

</Project>
