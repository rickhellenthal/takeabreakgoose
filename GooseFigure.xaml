<UserControl x:Class="TakeABreakGoose.GooseFigure"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="120" Height="182">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Feathers" Color="#F1EAD2" />
        <SolidColorBrush x:Key="FeatherShade" Color="#E2D8B8" />
        <SolidColorBrush x:Key="Coral" Color="#DD7752" />
        <SolidColorBrush x:Key="CoralDark" Color="#C2603E" />
        <SolidColorBrush x:Key="Mustard" Color="#D9A23A" />
        <SolidColorBrush x:Key="Slate" Color="#6F8A85" />
        <SolidColorBrush x:Key="Ink" Color="#33393A" />
    </UserControl.Resources>

    <!-- The goose, drawn facing right. Flip mirrors it to face left. -->
    <Canvas RenderTransformOrigin="0.5,0.5" Background="Transparent">
        <Canvas.RenderTransform>
            <ScaleTransform x:Name="Flip" ScaleX="1" />
        </Canvas.RenderTransform>

        <!-- Leaves room above the head for hats. -->
        <Canvas Canvas.Top="24">
            <Ellipse x:Name="Shadow" Canvas.Left="30" Canvas.Top="149" Width="66" Height="8" Fill="#22000000" />

            <!-- Back leg -->
            <Canvas>
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="LegBackRotate" CenterX="60" CenterY="128" />
                </Canvas.RenderTransform>
                <Line X1="60" Y1="126" X2="60" Y2="150" Stroke="{StaticResource CoralDark}" StrokeThickness="3.5"
                      StrokeStartLineCap="Round" />
                <Path Data="M 54,153 L 72,153 L 61,145 Z" Fill="{StaticResource CoralDark}"
                      Stroke="{StaticResource CoralDark}" StrokeThickness="2" StrokeLineJoin="Round" />
            </Canvas>

            <!-- Front leg -->
            <Canvas>
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="LegFrontRotate" CenterX="76" CenterY="128" />
                </Canvas.RenderTransform>
                <Line X1="76" Y1="126" X2="76" Y2="150" Stroke="{StaticResource Coral}" StrokeThickness="3.5"
                      StrokeStartLineCap="Round" />
                <Path Data="M 70,153 L 88,153 L 77,145 Z" Fill="{StaticResource Coral}"
                      Stroke="{StaticResource Coral}" StrokeThickness="2" StrokeLineJoin="Round" />
            </Canvas>

            <!-- Body, neck and head bob together while walking -->
            <Canvas>
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="BodyBob" />
                </Canvas.RenderTransform>

                <!-- Body and neck in one silhouette -->
                <Path Fill="{StaticResource Feathers}"
                      Data="M 6,96 C 24,97 50,92 64,72 C 66,58 64,40 66,22 L 88,22
                            C 88,40 86,56 92,72 C 102,86 106,104 100,116
                            C 92,132 66,136 48,132 C 30,128 14,114 6,96 Z" />
                <!-- Wing and tail feathers -->
                <Path Fill="{StaticResource FeatherShade}"
                      Data="M 22,102 C 38,90 64,90 84,104 C 70,116 44,118 22,102 Z" />
                <Path Stroke="{StaticResource Feathers}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" Data="M 34,104 C 44,100 54,100 62,103 M 40,110 C 50,107 60,107 68,109" />
                <Path Stroke="{StaticResource FeatherShade}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" Data="M 10,98 C 16,100 22,100 28,98 M 14,104 C 20,106 26,106 30,104" />

                <!-- Outfit: bandana -->
                <Canvas x:Name="Bandana" Visibility="Collapsed">
                    <Path Fill="{StaticResource Slate}" Data="M 65,48 L 57,43 L 59,52 Z M 65,48 L 55,52 L 61,56 Z" />
                    <Path Fill="{StaticResource Slate}"
                          Data="M 62,47 C 72,54 84,56 94,51 L 91,84 C 84,74 72,62 62,47 Z" />
                    <Ellipse Canvas.Left="70" Canvas.Top="55" Width="3" Height="3" Fill="{StaticResource Mustard}" />
                    <Ellipse Canvas.Left="79" Canvas.Top="58" Width="3" Height="3" Fill="{StaticResource Mustard}" />
                    <Ellipse Canvas.Left="87" Canvas.Top="56" Width="3" Height="3" Fill="{StaticResource Mustard}" />
                    <Ellipse Canvas.Left="83" Canvas.Top="65" Width="3" Height="3" Fill="{StaticResource Mustard}" />
                    <Ellipse Canvas.Left="76" Canvas.Top="64" Width="3" Height="3" Fill="{StaticResource Mustard}" />
                    <Ellipse Canvas.Left="88" Canvas.Top="72" Width="3" Height="3" Fill="{StaticResource Mustard}" />
                </Canvas>

                <!-- Outfit: raincoat cape (its hood is on the head) -->
                <Canvas x:Name="RaincoatCape" Visibility="Collapsed">
                    <Path Fill="{StaticResource Slate}"
                          Data="M 62,28 C 56,54 44,80 28,97 L 37,99 C 50,80 60,54 66,30 Z" />
                    <Path Fill="{StaticResource Mustard}"
                          Data="M 64,26 C 58,52 46,78 32,97 C 56,105 86,100 100,90
                                C 94,74 90,56 92,34 C 84,30 72,28 64,26 Z" />
                    <Path Stroke="{StaticResource Ink}" StrokeThickness="1.4" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 87,44 C 93,40 97,44 93,47 C 91,48 88,46 87,44 C 85,50 87,54 91,56" />
                </Canvas>

                <!-- Head, which tilts on its own -->
                <Canvas>
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="HeadTilt" CenterX="77" CenterY="24" />
                    </Canvas.RenderTransform>
                    <Ellipse Canvas.Left="63" Canvas.Top="4" Width="28" Height="24" Fill="{StaticResource Feathers}" />
                    <Path Fill="{StaticResource Coral}"
                          Data="M 86,11 C 95,9 104,11 109,16 C 104,21 95,22 87,22 Z" />
                    <Ellipse Canvas.Left="79" Canvas.Top="11" Width="4" Height="4" Fill="{StaticResource Ink}" />

                    <!-- Outfit: raincoat hood -->
                    <Canvas x:Name="RaincoatHood" Visibility="Collapsed">
                        <Path Fill="{StaticResource Mustard}"
                              Data="M 60,34 C 52,14 62,-4 80,-3 C 90,-2 96,4 95,11
                                    C 88,5 76,3 70,10 C 64,17 66,28 68,34 Z" />
                        <Path Stroke="{StaticResource Slate}" StrokeThickness="3" StrokeLineJoin="Round"
                              Data="M 95,11 C 88,5 76,3 70,10 C 64,17 66,28 68,34" />
                    </Canvas>

                    <!-- Outfit: bonnet -->
                    <Canvas x:Name="Bonnet" Visibility="Collapsed">
                        <Path Fill="{StaticResource Mustard}" Data="M 62,14 C 57,-6 87,-12 93,6 Z" />
                        <Path Fill="{StaticResource Mustard}"
                              Data="M 53,17 C 57,4 92,-7 103,1 C 103,9 68,21 53,17 Z" />
                        <Path Stroke="{StaticResource Slate}" StrokeThickness="3.5"
                              Data="M 62,11 C 71,4 84,1 93,5" />
                        <Path Stroke="{StaticResource Ink}" StrokeThickness="1.4" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 66,15 C 63,24 66,30 72,31 M 72,31 C 66,27 64,34 70,34 C 72,34 73,32 72,31
                                    C 76,28 79,33 75,35 C 73,35 72,33 72,31" />
                    </Canvas>

                    <!-- Outfit: party hat -->
                    <Canvas x:Name="PartyHat" Visibility="Collapsed">
                        <Path Stroke="{StaticResource Ink}" StrokeThickness="1.2"
                              Data="M 69,8 C 65,18 68,28 78,31" />
                        <Path Fill="{StaticResource Mustard}" Data="M 67,9 L 87,6 L 76,-20 Z" />
                        <Canvas Clip="M 67,9 L 87,6 L 76,-20 Z">
                            <Path Stroke="{StaticResource Coral}" StrokeThickness="3.5"
                                  Data="M 60,1 L 95,-4 M 60,-8 L 95,-13" />
                        </Canvas>
                        <Ellipse Canvas.Left="72.5" Canvas.Top="-25" Width="7" Height="7" Fill="{StaticResource Coral}" />
                    </Canvas>
                </Canvas>
            </Canvas>
        </Canvas>
    </Canvas>
</UserControl>
